{
  "name": "order-replication-utility",
  "version": "1.0.0",
  "description": "Order replication utility",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @app/shared && npm run build -w @app/worker && npm run build -w @app/web",
    "worker:install": "node apps/worker/dist/service-install.js",
    "worker:uninstall": "node apps/worker/dist/service-uninstall.js",
    "typecheck": "npm run typecheck -w @app/shared && npm run typecheck -w @app/worker && npm run typecheck -w @app/web",
    "mock": "node tools/mock-server.mjs",
    "mock:seed": "node tools/seed-mock-config.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
