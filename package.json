{
  "name": "order-replication-utility",
  "version": "1.0.0",
  "description": "Order replication utility",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "npm run clean && tsc",
    "build:watch": "npm run clean && tsc --watch",
    "start": "node --env-file .env dist/index.js",
    "dev": "concurrently \"tsc --watch\" \"nodemon --watch dist --exec node --env-file .env dist/index.js\"",
    "typecheck": "tsc --noEmit",
    "mock": "node tools/mock-server.mjs",
    "service:install": "node --env-file .env dist/service-install.js",
    "service:uninstall": "node dist/service-uninstall.js"
  },
  "dependencies": {
    "@sentry/node": "^10.56.0",
    "node-windows": "^1.0.0-beta.8",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-windows": "^0.1.6",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.0"
  }
}
