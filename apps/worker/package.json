  },
  "dependencies": {
    "@app/shared": "*",
    "node-windows": "^1.0.0-beta.8",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node-windows": "^0.1.6",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  }
}
