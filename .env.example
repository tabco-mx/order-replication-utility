WANSOFT_BASE_URL=http://localhost:80
WANSOFT_USER_CODE=005

REMOTE_API_BASE_URL=http://remote-server
REMOTE_API_TOKEN=secret

REPLICATION_INTERVAL_MS=30000

# Logging: set NODE_ENV=production for raw JSON logs; anything else gets pretty output.
# LOG_LEVEL defaults to "info" (trace|debug|info|warn|error|fatal).
NODE_ENV=production
LOG_LEVEL=info
